    %% Netzwerk
    FB --> SW
    SW --> NAS
    SW -->|LAN| SLZB
    FB -. "abklemmen" .-> WB

    %% EnOcean / Eltako
    HA <-->|"USB · Docker device passthrough"| USB
    USB <--> FAM14
    FAM14 <-->|RS485-Bus| FSR
    FAM14 <-->|RS485-Bus| FUD
    FAM14 <-->|RS485-Bus| FSB
    FAM14 <-->|"RS485-Bus\nSollwert A5-10-06"| F4HK
    F4HK -->|230V / 24V| EVENES
    FFT -. "Funk" .-> FAM14
    TASTER -. "Funk (direkt)" .-> FSR
    TASTER -. "Funk (direkt)" .-> FSB
    TASTER -. "Funk" .-> FAM14

    %% Zigbee
    HA <-->|MQTT| MQ
    MQ <-->|MQTT| Z2M
    Z2M <-->|"TCP :6638"| SLZB
    SLZB -. "Zigbee" .-> ZLIGHT
    SLZB -. "Zigbee" .-> ZSENS
    ZLIGHT -. "Mesh" .-> ZSENS

    %% Altsystem (entfällt)
    HA -. "entfällt" .-> MS
    MS -. "Matter · entfällt" .-> WB

